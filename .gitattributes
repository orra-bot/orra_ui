# Normalize line endings so formatting and guardrails behave the same on every OS.
* text=auto eol=lf

# Windows-only files keep CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary assets.
*.png binary
*.ico binary
*.ttf binary
*.otf binary

# Generated by Flutter; collapse in diffs.
pubspec.lock linguist-generated=true
**/generated_plugin_registrant.* linguist-generated=true
**/generated_plugins.cmake linguist-generated=true
**/GeneratedPluginRegistrant.swift linguist-generated=true
